PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/nexus_arena?replicaSet=rs0
# Set a unique random secret with at least 32 bytes before starting the API.
JWT_SECRET=
# Token lifetime accepted by jsonwebtoken, such as 1h or 1d.
JWT_EXPIRES_IN=1h
# Booking session rules, in minutes.
BOOKING_MIN_DURATION_MINUTES=30
BOOKING_MAX_DURATION_MINUTES=720
BOOKING_DURATION_STEP_MINUTES=30
# Abandoned station reservations become reclaimable after this lease expires.
BOOKING_LOCK_TTL_MS=120000
# Simulated wallet top-up limits, in integer paise (₹1 to ₹10,000 by default).
WALLET_TOPUP_MIN_MINOR=100
WALLET_TOPUP_MAX_MINOR=1000000
# Allowed browser origin(s), comma-separated. Production must set this to the deployed client origin.
CLIENT_ORIGIN=http://localhost:5173
# Per-IP limit for each registration and login route.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
# Optional local-only demo accounts. The seed script creates them only when the email and password pair are set.
DEMO_ADMIN_NAME=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_USER_NAME=
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
